# ============================================================
# Скопируй в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git — он уже в .gitignore.
# ============================================================

# --- Активы ---
# Через запятую. На каждый актив заводится независимый поток по каждому
# таймфрейму (15m и 1h — см. src/timeframes.py), итого ASSETS x 2 потоков.
ASSETS=btc,eth,sol,bnb,hype,xrp

# --- Таймфреймы ---
# Через запятую: "5m", "15m", "1h" или комбинация. По умолчанию только 15m —
# 5m и 1h стратегии в коде остались (см. src/timeframes.py), просто сейчас
# выключены. Чтобы вернуть — допиши нужную метку сюда, без правки кода.
ENABLED_TIMEFRAMES=15m

# --- Источник цены/индикаторов (Binance, публичный API, ключ не нужен) ---
BINANCE_BASE_URL=https://api.binance.com
# Фолбэк для монет без спотовой пары на обычном Binance (на момент
# написания это под вопросом для HYPE — есть точно на фьючерсах).
BINANCE_FUTURES_URL=https://fapi.binance.com
ATR_LOOKBACK_FOR_REGIME=60

# --- Настройки таймфрейма 5m (НЕПРОВЕРЕННЫЕ на реальных данных догадки,
# пропорционально пересчитанные из 15m — присматривайся к первым отчётам) ---
# TF_5M_KLINE_INTERVAL=1m
# TF_5M_ATR_PERIOD=7
# TF_5M_EMA_FAST=3
# TF_5M_EMA_SLOW=7
# TF_5M_MIN_MINUTES_LEFT=1
# TF_5M_MAX_MINUTES_LEFT=3.5
# TF_5M_ATR_DISTANCE_MULT=1.5
# TF_5M_ATR_SPIKE_MULT=2.2
# TF_5M_POLL_SECONDS=3

# --- Настройки таймфрейма 15m (можно не трогать — разумные дефолты) ---
# TF_15M_KLINE_INTERVAL=1m
# TF_15M_ATR_PERIOD=14
# TF_15M_EMA_FAST=9
# TF_15M_EMA_SLOW=21
# TF_15M_MIN_MINUTES_LEFT=2
# TF_15M_MAX_MINUTES_LEFT=9
# TF_15M_ATR_DISTANCE_MULT=1.5
# TF_15M_ATR_SPIKE_MULT=2.2
# TF_15M_POLL_SECONDS=5

# --- Настройки таймфрейма 1h ---
# Индикаторы на 5-минутных свечах (не 1-минутных) — соразмерно часовому
# окну. Окно входа шире и позже: 10-45 из 60 минут вместо 2-9 из 15.
# TF_1H_KLINE_INTERVAL=5m
# TF_1H_ATR_PERIOD=14
# TF_1H_EMA_FAST=9
# TF_1H_EMA_SLOW=21
# TF_1H_MIN_MINUTES_LEFT=10
# TF_1H_MAX_MINUTES_LEFT=45
# TF_1H_ATR_DISTANCE_MULT=1.3
# TF_1H_ATR_SPIKE_MULT=2.2
# TF_1H_POLL_SECONDS=20

# --- Polymarket / CLOB ---
POLY_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLY_CHAIN_ID=137
# Приватный ключ кошелька, которым торгуешь. ДЕРЖИ В СЕКРЕТЕ.
# Рекомендуется отдельный "торговый" кошелёк, а не основной.
POLY_PRIVATE_KEY=
# Нужен, только если торгуешь не с адреса, выведенного из приватного ключа
# (например, отдельный кошелёк на Polymarket). В большинстве случаев,
# включая email/Magic-логин, можно оставить пустым — SDK сам разберётся.
POLY_FUNDER_ADDRESS=
# Больше не используется (актуальный SDK polymarket-client сам определяет
# тип кошелька) — оставлено на случай отката на другой клиент.
POLY_SIGNATURE_TYPE=0

# --- Диапазон входа (общий для всех активов/таймфреймов) ---
MIN_ENTRY_PRICE=0.90
MAX_ENTRY_PRICE=0.95

# --- Пороги безопасности (общие; регулируется и кнопкой ⚙️ в Telegram) ---
SAFETY_SCORE_THRESHOLD=75
MIN_BOOK_LIQUIDITY_USDC=25

# --- Латентность исполнения ---
# Живой WS-стакан вместо REST-поллинга при каждом тике (см. src/book_stream.py).
USE_LIVE_BOOK_STREAM=true
# Запас на слиппедж поверх цены ask, увиденной на сигнале, на случай, если
# книга Polymarket успеет уйти за время между решением и отправкой ордера.
LIVE_ENTRY_MAX_SLIPPAGE=0.01
# Жёсткий потолок цены исполнения — даже с учётом слиппеджа никогда не
# платим больше этого, что бы ни случилось со стаканом.
MAX_ENTRY_EXECUTION_PRICE=0.97

# --- Управление капиталом ---
# TRADE_SIZE_USDC здесь НЕ используется (это персональный бот только под
# хедж-идею, без основной сигнальной стратегии) — реальный размер ставки
# см. HEDGE_STAKE_USDC ниже, регулируется и кнопкой в Telegram.
# Общий потолок ОДНОВРЕМЕННО открытых хедж-позиций по ВСЕМ активам/
# таймфреймам — без него несколько сигналов могут совпасть по времени.
MAX_OPEN_POSITIONS=6
# Ниже этой суммы даже не пытаемся входить — если в стакане меньше объёма
# по нужной цене, тик тихо пропускается (это не ошибка, просто неликвидно).
# Реальный минимум ордера на Polymarket — $1.
MIN_VIABLE_TRADE_USDC=1
DAILY_LOSS_LIMIT_USDC=20

# --- Режим работы ---
# ОБЯЗАТЕЛЬНО прогони бота в DRY_RUN=true как минимум несколько дней и
# посмотри на отчёты, прежде чем включать реальные сделки.
DRY_RUN=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=data/bot.db

# --- Отчёты ---
# Каждые N часов бот присылает в Telegram momentum- и hedge-CSV (у этого
# бота нет основной стратегии, поэтому signals/trades отчётов нет).
REPORT_INTERVAL_HOURS=4

# --- Диапазон наблюдения momentum-трекера (не торговый вход!) ---
# 0.65, не 0.70 — специально расширено 2026-09-22, чтобы проверить, не
# окажется ли вход ЕЩЁ раньше 0.70 ещё выгоднее (полный перебор пар
# вход/выход показал: чем раньше вход, тем обычно лучше — но данных ниже
# 0.70 пока не было). Реальный вход хедж-бота — отдельная настройка
# HEDGE_ENTRY_PRICE выше, её трогать не нужно, пока не наберём данные.
MOMENTUM_MIN_PRICE=0.65
MOMENTUM_MAX_PRICE=0.95
REPORTS_DIR=data/reports

# --- Хедж-бот (см. src/hedge_bot.py) ---
# Всё это регулируется и кнопкой "🔒 Хедж-бот" в /menu — значения ниже
# только начальные дефолты при первом запуске (пустая база).
HEDGE_ENTRY_PRICE=0.70
# Насколько выше HEDGE_ENTRY_PRICE ещё можно входить — если цена уже
# проскочила дальше между тиками (типично на 5m), пропускаем это окно.
# Найдено на реальных данных 2026-09-20: без этого ограничения средняя
# цена входа была 0.839 вместо 0.70 — экономика хеджа рассчитана именно
# на вход БЛИЗКО к 0.70.
HEDGE_ENTRY_TOLERANCE=0.03
# Как часто проверять цену для входа/хеджа — читает уже живой WS-стакан,
# внешних запросов не делает, поэтому можно часто (в отличие от опроса
# рынка/индикаторов, который дёргает Gamma/Binance API и намеренно не
# ускорен). 1 секунда — разумный компромисс при 12 параллельных потоках.
HEDGE_POLL_SECONDS=1
HEDGE_TRIGGER_PRICE=0.95
# Продажа на пороге ВЫКЛ по умолчанию (анализ 2026-09-23): из 187 позиций,
# проданных по 0.95, 183 выиграли бы и так — выгоднее держать до резолюции.
HEDGE_TAKE_PROFIT_ENABLED=false
# Окно входа по времени (доля прошедшего окна рынка). На 5m вход при
# 30-70% прошедшего времени — winrate 79.9%, +10.6% ROI на 1231 сессии;
# ранний вход стабильно в минусе.
HEDGE_ENTRY_MIN_ELAPSED=0.30
HEDGE_ENTRY_MAX_ELAPSED=0.70
# Таймфреймы для ВХОДОВ (наблюдение momentum идёт на всех). 15m около нуля.
HEDGE_TIMEFRAMES=5m
# $10, не $5 — при входе 0.70/хедже 0.90 нога хеджа стоит stake*0.143;
# при $5 это $0.71, ниже минимального ордера $1 — хедж не смог бы
# исполниться вообще. Бот сам блокирует вход и предупредит в Telegram,
# если текущее сочетание ставка/вход/хедж физически не позволяет
# захеджироваться, но лучше сразу поставить безопасное значение.
HEDGE_STAKE_USDC=10
