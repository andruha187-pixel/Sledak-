# --- Telegram ---
# Можно использовать тот же токен, что у торгового бота — этот скрипт
# только ОТПРАВЛЯЕТ сообщения, не слушает команды, конфликта не будет.
# Если хочешь отдельный чат/бот для организации — заведи новый через
# @BotFather, это тоже нормально.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Фильтры поиска ---
MIN_PRICE=0.80
MAX_PRICE=0.95
# Минимальный объём в USD — отсекаем совсем тонкие/неликвидные рынки
MIN_VOLUME_USD=20000
# Не смотрим рынки, которые резолвятся позже, чем через N дней
MAX_DAYS_OUT=180

# --- Периодичность ---
# Раз в сколько часов сканировать. Политика/финансы не требуют секундной
# частоты, как крипто-рынки — раз в 4-6 часов вполне достаточно.
SCAN_INTERVAL_HOURS=6

# --- Storage ---
DB_PATH=data/scanner.db
